---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import JsonLd from '~/components/seo/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { appsForLocale } from '~/data/apps';
import { pageContent, toHubView } from '~/data/content';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '~/i18n/locales';
import { absolute, appsIndexPaths, href, requireSite } from '~/i18n/routes';
import { FAMILY_KEY, useTranslations } from '~/i18n/t';

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({
    params: { locale: locale === DEFAULT_LOCALE ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = requireSite(Astro.site);
const apps = appsForLocale(locale);

/**
 * Ce hub etait un DOUBLON de l accueil : meme chapo, meme liste des cinq apps,
 * a un numero de version pres. Google explorait 18 pages de ~60 mots
 * n apportant rien que l accueil n ait deja, et les classait toutes en
 * « Exploree, actuellement non indexee ».
 *
 * Il a donc maintenant sa propre prose, dans `pages/apps.<locale>.md`, et elle
 * repond a une question que l accueil ne traite pas : LAQUELLE des cinq choisir,
 * et jusqu ou l interface de chacune est reellement traduite.
 *
 * Sans ce fichier, `toHubView` retombe en `noindex` — la page reste un noeud de
 * navigation (le fil d Ariane de chaque page d application y renvoie) mais sort
 * de l index et du sitemap. C est la meme regle que pour les pages
 * d application : indexable quand c est merite, et le build en juge.
 */
const view = toHubView(locale, (await pageContent()).get('apps')?.get(locale));
const Body = view.entry ? (await render(view.entry)).Content : null;

const canonical = absolute(locale, 'apps');
const breadcrumbs = [
  { name: t('nav.home'), url: absolute(locale, '') },
  { name: t('apps.title'), url: canonical },
];
---

<BaseLayout
  locale={locale}
  paths={appsIndexPaths()}
  path="apps"
  title={view.title}
  description={view.metaDescription}
  noindex={view.noindex}
  updatedOn={view.updatedOn}
>
  <JsonLd
    locale={locale}
    url={canonical}
    siteUrl={site.href}
    siteName={t('site.name')}
    breadcrumbs={breadcrumbs}
    faq={view.faq}
  />

  <section class="wrap">
    <nav aria-label={t('breadcrumb.label')} class="crumbs">
      <a href={href(locale, '')}>{t('nav.home')}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{t('apps.title')}</span>
    </nav>

    <h1>{view.h1}</h1>
    <p class="lead prose">{view.lead}</p>

    <ul role="list" class="list">
      {
        apps.map((app) => (
          <li class="row" style={`--accent: ${app.accent}; --accent-text: ${app.accentText}`}>
            <a href={href(locale, `apps/${app.slug}`)}>
              <span class="family">{t(FAMILY_KEY[app.family])}</span>
              <span class="name">{app.name}</span>
              <span class="meta">
                {app.status === 'coming-soon'
                  ? t('apps.comingSoon')
                  : `${t('apps.version')} ${app.version}`}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    {Body && <div class="prose body"><Body /></div>}

    {
      view.faq.length > 0 && (
        <div class="faq">
          <h2>{t('faq.title')}</h2>
          <dl>
            {view.faq.map((item) => (
              <div class="qa">
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  section {
    padding-block: var(--space-4) var(--space-6);
  }
  .crumbs {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    font-size: var(--step--1);
    color: var(--text-500);
    margin-block-end: var(--space-3);
  }
  .lead {
    margin-block-start: var(--space-2);
    font-size: var(--step-1);
  }
  .list {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
  }
  .row {
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
  }
  .row:hover {
    border-color: var(--glass-border-hover);
  }
  .row a {
    display: grid;
    gap: 0.2rem;
    padding: var(--space-3);
    text-decoration: none;
    color: inherit;
  }
  .family {
    color: var(--accent-text, var(--accent));
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .name {
    color: var(--text-100);
    font-size: var(--step-1);
    font-weight: 800;
  }
  .meta {
    color: var(--text-500);
    font-size: var(--step--1);
  }
  .body,
  .faq {
    margin-block-start: var(--space-5);
  }
  .qa + .qa {
    margin-block-start: var(--space-3);
  }
  .faq dl {
    margin-block-start: var(--space-3);
  }
  .faq dt {
    color: var(--text-100);
    font-weight: 700;
  }
  .faq dd {
    margin-block-start: 0.3rem;
    margin-inline-start: 0;
    max-inline-size: var(--measure);
  }

  .body :global(h2) {
    margin-block-start: var(--space-4);
  }
  .body :global(h3) {
    margin-block-start: var(--space-3);
    color: var(--text-100);
  }
  .body :global(p),
  .body :global(ul) {
    margin-block-start: var(--space-2);
  }
  .body :global(li) {
    margin-block-start: 0.35rem;
  }
  .body :global(a) {
    color: var(--accent-text, var(--accent));
  }
  .body :global(table) {
    inline-size: 100%;
    margin-block-start: var(--space-3);
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  .body :global(th),
  .body :global(td) {
    padding: 0.55em 0.7em;
    border-block-end: 1px solid var(--glass-border);
    text-align: start;
    vertical-align: top;
  }
  .body :global(th) {
    color: var(--text-100);
  }
</style>
