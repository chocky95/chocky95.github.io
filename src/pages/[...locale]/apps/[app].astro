---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import BaseLayout from '~/layouts/BaseLayout.astro';
import { APPS, type AppFacts } from '~/data/apps';
import { appContent, toAppView } from '~/data/content';
import { DEFAULT_LOCALE, type Locale } from '~/i18n/locales';
import { appPaths, href, requireSite, switcherLinks } from '~/i18n/routes';
import { FAMILY_KEY, useTranslations } from '~/i18n/t';

/**
 * Le point crucial du site.
 *
 * Les chemins derivent de `app.locales`, donc une combinaison hors
 * sous-ensemble -- /ru/apps/scanfree/, /en/apps/easycompta/ -- n'est jamais
 * generee. Les hreflang derivent de la MEME table via `appPaths`, ce qui rend
 * impossible un cluster pointant vers une URL absente.
 */
export const getStaticPaths = (() => {
  const paths = [];

  for (const app of APPS) {
    for (const locale of app.locales) {
      paths.push({
        params: {
          locale: locale === DEFAULT_LOCALE ? undefined : locale,
          app: app.slug,
        },
        props: { locale, app },
      });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  app: AppFacts;
}

const { locale, app } = Astro.props;
const t = useTranslations(locale);

const paths = appPaths(app);
const path = `apps/${app.slug}`;

const byLocale = (await appContent()).get(app.slug);
const view = toAppView(app, locale, byLocale?.get(locale));

const Body = view.entry ? (await render(view.entry)).Content : null;

// Les autres applications de la meme famille, dans cette langue : maillage
// interne a ancre descriptive. Les jeux se croisent entre eux ; EasyCompta
// n'entre pas dans le corps d'une page de jeu.
const siblings = APPS.filter(
  (other) =>
    other.slug !== app.slug && other.family === app.family && other.locales.includes(locale),
);

const langs = switcherLinks(paths, locale);

// Image de partage propre a l app, generee par scripts/generate-og.mjs.
const ogImage = new URL(`og/${app.slug}.png`, requireSite(Astro.site)).href;
---

<BaseLayout
  locale={locale}
  paths={paths}
  path={path}
  title={view.title}
  description={view.metaDescription}
  ogType="article"
  ogImage={ogImage}
  noindex={view.noindex}
  updatedOn={view.updatedOn}
  accent={app.accent} accentText={app.accentText}
>
  <article class="wrap">
    <nav aria-label={t('breadcrumb.label')} class="crumbs">
      <a href={href(locale, '')}>{t('nav.home')}</a>
      <span aria-hidden="true">›</span>
      <a href={href(locale, 'apps')}>{t('apps.title')}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{app.name}</span>
    </nav>

    <header class="head">
      <p class="family">{t(FAMILY_KEY[app.family])}</p>
      <h1>{view.h1}</h1>
      <p class="lead prose">{view.lead}</p>

      <p class="actions">
        {
          app.playUrl && (
            <a class="cta" href={app.playUrl} rel="noopener">
              {t('cta.play')}
            </a>
          )
        }
        {
          app.webAppUrl && (
            <a class="cta cta--ghost" href={app.webAppUrl} rel="noopener">
              {t('cta.webApp')}
            </a>
          )
        }
        {app.status === 'coming-soon' && <span class="badge">{t('apps.comingSoon')}</span>}
      </p>
    </header>

    {
      view.highlights.length > 0 && (
        <ul role="list" class="highlights">
          {view.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    {Body && <div class="prose body"><Body /></div>}

    {
      view.faq.length > 0 && (
        <section class="faq">
          <h2>{t('faq.title')}</h2>
          <dl>
            {view.faq.map((item) => (
              <>
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </>
            ))}
          </dl>
        </section>
      )
    }

    <section class="specs">
      <h2>{t('apps.availableOn')}</h2>
      <dl class="spec-list">
        <dt>{t('apps.version')}</dt>
        <dd>{app.version}</dd>
        <dt>{t('apps.availableOn')}</dt>
        <dd>{app.stores.length > 0 ? app.stores.join(', ') : t('apps.comingSoon')}</dd>
      </dl>
    </section>

    {
      siblings.length > 0 && (
        <section class="siblings">
          <h2>{t('footer.otherApps')}</h2>
          <ul role="list">
            {siblings.map((other) => (
              <li>
                <a href={href(locale, `apps/${other.slug}`)}>{other.name}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      langs.length > 1 && (
        <nav class="langs" aria-label={t('lang.label')}>
          <details>
            <summary>{t('lang.choose')}</summary>
            <ul role="list">
              {langs.map((entry) => (
                <li>
                  {entry.isCurrent ? (
                    <span aria-current="true">{entry.locale}</span>
                  ) : (
                    <a href={entry.href} hreflang={entry.locale}>
                      {entry.locale}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </details>
        </nav>
      )
    }

    {app.trademarkNotice && <p class="trademark">{app.trademarkNotice}</p>}

    {
      view.updatedOn && (
        <p class="updated">
          {t('meta.updatedOn')}{' '}
          <time datetime={view.updatedOn.toISOString()}>
            {view.updatedOn.toISOString().slice(0, 10)}
          </time>
        </p>
      )
    }
  </article>
</BaseLayout>

<style>
  article {
    padding-block: var(--space-4) var(--space-6);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
    font-size: var(--step--1);
    color: var(--text-500);
    margin-block-end: var(--space-3);
  }
  .family {
    color: var(--accent-text, var(--accent));
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .head h1 {
    margin-block-start: var(--space-1);
  }
  .lead {
    margin-block-start: var(--space-3);
    font-size: var(--step-1);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-block-start: var(--space-4);
  }
  .cta {
    padding: 0.7em 1.4em;
    border-radius: 999px;
    background: var(--accent-text, var(--accent));
    color: var(--ink-900);
    font-weight: 700;
    text-decoration: none;
  }
  .cta--ghost {
    background: transparent;
    color: var(--accent-text, var(--accent));
    border: 1px solid var(--glass-border-hover);
  }
  .badge {
    padding: 0.35em 0.9em;
    border: 1px solid var(--glass-border-hover);
    border-radius: 999px;
    color: var(--text-500);
    font-size: var(--step--1);
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-2);
    margin-block: var(--space-5) 0;
    padding: 0;
  }
  .highlights li {
    padding: var(--space-3);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    background: var(--glass-bg);
  }
  .body,
  .faq,
  .specs,
  .siblings {
    margin-block-start: var(--space-5);
  }
  .spec-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-3);
    margin-block-start: var(--space-2);
  }
  .spec-list dt {
    color: var(--text-500);
  }
  .faq dt {
    color: var(--text-100);
    font-weight: 700;
    margin-block-start: var(--space-3);
  }
  .siblings ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
    padding: 0;
  }
  .langs {
    margin-block-start: var(--space-5);
    font-size: var(--step--1);
  }
  .langs ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
    padding: 0;
  }
  .trademark,
  .updated {
    margin-block-start: var(--space-4);
    font-size: var(--step--1);
    color: var(--text-700);
  }
</style>
