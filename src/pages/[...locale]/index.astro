---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import JsonLd from '~/components/seo/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { appsForLocale } from '~/data/apps';
import { guidesForLocale, pageContent, toHomeView, toHubView } from '~/data/content';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '~/i18n/locales';
import { absolute, href, homePaths, requireSite } from '~/i18n/routes';
import { FAMILY_KEY, useTranslations } from '~/i18n/t';

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({
    // `undefined` pour la locale par defaut : elle sert la racine, sans prefixe.
    params: { locale: locale === DEFAULT_LOCALE ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = requireSite(Astro.site);
const apps = appsForLocale(locale);

/**
 * La prose de l'accueil vit dans `src/content/pages/home.<locale>.md`.
 *
 * ── Pourquoi ce fichier a change ─────────────────────────────────────────
 * L'accueil se reduisait a un chapo et cinq noms d'application : environ 60
 * mots, dans les 18 langues. Search Console explorait les 18 pages et les
 * ecartait toutes en « Exploree, actuellement non indexee ». Il n'y avait rien
 * a reparer dans le code — il manquait du contenu, et le contenu ne peut pas
 * vivre dans `i18n/ui`, reserve aux chaines d'interface.
 *
 * La duplication entre langues n'est PAS le probleme : hreflang la resout, et
 * Google ne penalise pas une traduction. C'est la minceur qui bloquait, plus la
 * duplication INTERNE entre cet accueil et le hub `/apps/` (voir la note en
 * tete de `apps/index.astro`).
 */
const pages = await pageContent();
const view = toHomeView(locale, pages.get('home')?.get(locale));
const Body = view.entry ? (await render(view.entry)).Content : null;

/**
 * Le hub `/apps/` n'etait lie par AUCUN accueil : `dist/index.html` ne contenait
 * pas une seule fois `href="/apps/"`. Ses seuls liens entrants venaient des 5
 * fils d'Ariane de sa langue et des 17 selecteurs de langue des autres — donc a
 * 2 clics de l'accueil, ce qui est exactement le profil d'une page « Detectee,
 * actuellement non indexee » dans Search Console.
 *
 * On emprunte son `h1` comme ancre plutot que d'inventer une chaine
 * d'interface : l'ancre est ainsi egale au h1 de la cible, traduite par le
 * contenu dans les 18 langues, et elle suivra toute reecriture du hub. Elle dit
 * aussi ce que le hub apporte que l'accueil n'apporte pas — « comparees » —, ce
 * qui est la meilleure protection contre la cannibalisation des deux pages.
 */
const hub = toHubView(locale, pages.get('apps')?.get(locale));

/**
 * Les guides de cette langue, depuis la collection.
 *
 * 6 accueils sur 18 liaient leur guide, et seulement par leur prose Markdown :
 * les 12 traductions ajoutees ensuite n'etaient rattachees a rien. Le lien passe
 * donc dans le gabarit, ou il est uniforme sur les 18 langues et ou les futures
 * regles du Papayoo apparaitront sans retoucher un seul fichier.
 *
 * Les 6 liens en prose sont CONSERVES : un lien dans une phrase qui parle du
 * sujet vaut plus qu'un lien de gabarit, et l'accueil lie deja chaque
 * application deux fois (carte + prose) sans que cela ait jamais pose probleme.
 * Le bloc est place APRES la prose, il se lit donc comme un « pour aller plus
 * loin » et non comme une redite.
 */
const guides = await guidesForLocale(locale);

const canonical = absolute(locale, '');
---

<BaseLayout
  locale={locale}
  paths={homePaths()}
  path=""
  title={view.title}
  description={view.metaDescription}
  updatedOn={view.updatedOn}
>
  {/*
    `organization` est documente dans JsonLd comme « reserve a l'accueil » —
    et l'accueil ne l'emettait pas. Organization et WebSite sont les deux
    entites qui rattachent toutes les pages du domaine a un editeur unique.
  */}
  <JsonLd
    locale={locale}
    url={canonical}
    siteUrl={site.href}
    siteName={t('site.name')}
    organization={true}
    faq={view.faq}
  />

  <section class="wrap hero">
    <p class="eyebrow">{t('site.name')}</p>
    <h1>{view.h1}</h1>
    <p class="lead prose">{view.lead}</p>
  </section>

  <section class="wrap">
    <h2>{t('apps.title')}</h2>
    <ul role="list" class="grid">
      {
        apps.map((app) => (
          <li class="card" style={`--accent: ${app.accent}; --accent-text: ${app.accentText}`}>
            <a href={href(locale, `apps/${app.slug}`)}>
              <span class="family">{t(FAMILY_KEY[app.family])}</span>
              <span class="name">{app.name}</span>
              {app.status === 'coming-soon' && (
                <span class="badge">{t('apps.comingSoon')}</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="more">
      <a href={href(locale, 'apps')}>{hub.h1}<span aria-hidden="true"> →</span></a>
    </p>
  </section>

  {
    Body && (
      <section class="wrap">
        <div class="prose body">
          <Body />
        </div>
      </section>
    )
  }

  {
    guides.length > 0 && (
      <section class="wrap guides">
        <h2>{t('nav.guides')}</h2>
        <ul role="list">
          {guides.map((guide) => (
            <li>
              <a href={href(locale, guide.slug)}>{guide.h1}</a>
              <p>{guide.metaDescription}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    view.faq.length > 0 && (
      <section class="wrap faq">
        <h2>{t('faq.title')}</h2>
        <dl>
          {view.faq.map((item) => (
            <div class="qa">
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
  }
  .eyebrow {
    color: var(--accent-text, var(--accent));
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .lead {
    margin-block-start: var(--space-3);
    font-size: var(--step-1);
    color: var(--text-300);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin-block: var(--space-3) 0;
  }
  .card {
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
  }
  .card:hover {
    border-color: var(--glass-border-hover);
  }
  .card a {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
    text-decoration: none;
    color: inherit;
  }
  .family {
    color: var(--accent-text, var(--accent));
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .name {
    color: var(--text-100);
    font-size: var(--step-1);
    font-weight: 800;
  }
  .badge {
    justify-self: start;
    padding: 0.2em 0.7em;
    border: 1px solid var(--glass-border-hover);
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--text-500);
  }

  /* Lien vers le hub comparatif, sous la grille : l'endroit exact où le geste
     est naturel — « j'ai survolé les cinq, laquelle prendre ? ». */
  .more {
    margin-block-start: var(--space-3);
  }
  .more a {
    font-weight: 700;
  }

  .body,
  .guides,
  .faq {
    margin-block-start: var(--space-5);
  }

  /* Même bloc, même style que la section « guides » des pages d'application. */
  .guides ul {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
    padding: 0;
  }
  .guides li {
    padding: var(--space-3);
    border: 1px solid var(--glass-border);
    border-inline-start: 3px solid var(--accent-text);
    border-radius: var(--radius);
    background: var(--glass-bg);
  }
  .guides li a {
    font-weight: 700;
    font-size: var(--step-0);
  }
  .guides li p {
    margin-block-start: 0.4rem;
    color: var(--text-500);
    font-size: var(--step--1);
    max-inline-size: var(--measure);
  }
  /*
   * Pas de `padding-block-end` de fin de page : depuis que BaseLayout rend un
   * pied de page, c'est lui qui porte l'espace avant la fin du document (son
   * `margin-block-start`). Le cumuler avec un remplissage de section donnerait
   * douze rem de vide entre la FAQ et le pied de page.
   */
  .qa + .qa {
    margin-block-start: var(--space-3);
  }
  .faq dl {
    margin-block-start: var(--space-3);
  }
  .faq dt {
    color: var(--text-100);
    font-weight: 700;
  }
  .faq dd {
    margin-block-start: 0.3rem;
    margin-inline-start: 0;
    max-inline-size: var(--measure);
  }

  .body :global(h2) {
    margin-block-start: var(--space-4);
  }
  .body :global(h3) {
    margin-block-start: var(--space-3);
    color: var(--text-100);
  }
  .body :global(p),
  .body :global(ul) {
    margin-block-start: var(--space-2);
  }
  .body :global(li) {
    margin-block-start: 0.35rem;
  }
  .body :global(a) {
    color: var(--accent-text, var(--accent));
  }
</style>
